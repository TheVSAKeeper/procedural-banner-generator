    private async Task<object> McpCreateTemplateAsync(JsonObject args)
    {
        var requestedName = GetString(args, "name")?.Trim();
        var name = string.IsNullOrWhiteSpace(requestedName) ? NextProfileName() : UniqueProfileName(requestedName);

        ProfileEntry? baseProfile = null;
        if (GetString(args, "baseTemplateId") is { Length: > 0 } baseId
            || GetString(args, "baseTemplateName") is { Length: > 0 } baseName)
        {
            var lookup = new JsonObject
            {
                ["id"] = GetString(args, "baseTemplateId"),
                ["name"] = GetString(args, "baseTemplateName"),
            };
            baseProfile = FindProfile(lookup, required: true);
        }

        var baseState = baseProfile is not null
            ? baseProfile.State with { }
            : new SavedState
            {
                Title = "290. ЛЕДОКОЛ XIX",
                Subtitle = "КОРОЛЬ МАШИННОГО ЗАЛА",
                Tagline = "",
                Seed = 290,
                Width = 1280,
                Height = 720,
                Transparent = false,
                RenderDebounceMs = _renderDebounceMs,
                Style = new BannerStyle(),
            };

        var updatedState = ApplyPartialPatch(baseState, args, out var changedSections);
        var entry = new ProfileEntry { Id = NewId(), Name = name, State = updatedState };
        _profiles.Add(entry);

        var activate = GetBool(args, "activate", defaultValue: true);
        if (activate)
        {
            _activeId = entry.Id;
            ApplyState(entry.State);
            Render();
        }

        _error = null;
        _notice = $"MCP: создан шаблон «{entry.Name}»";
        await PersistProfilesAsync();
        StateHasChanged();

        var includePreview = GetBool(args, "includePreviewPng", defaultValue: true);
        return BuildTemplatePayload(entry, changedSections, includePreview);
    }

    private async Task<object> McpUpdateTemplateAsync(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        if (GetString(args, "newName") is { } newName && !string.IsNullOrWhiteSpace(newName))
        {
            var trimmedName = newName.Trim();
            EnsureUniqueProfileName(trimmedName, entry.Id);
            entry.Name = trimmedName;
        }

        var beforeState = entry.State;
        var updatedState = ApplyPartialPatch(beforeState, args, out var changedSections);
        var summary = GetString(args, "summary")?.Trim();

        if (HasTemplateChanged(beforeState, updatedState))
        {
            PushHistory(entry, DescribeChange("MCP: правка", beforeState, updatedState, summary), beforeState);
            _lastManualPushTicks = 0;
        }

        entry.State = updatedState;

        var activate = GetBool(args, "activate", defaultValue: true);
        if (activate || entry.Id == _activeId)
        {
            _activeId = entry.Id;
            ApplyState(entry.State);
            Render();
        }

        _error = null;
        _notice = string.IsNullOrWhiteSpace(summary)
            ? $"MCP: обновлён шаблон «{entry.Name}»"
            : $"MCP: «{entry.Name}» – {summary}";
        await PersistProfilesAsync();
        StateHasChanged();

        var includePreview = GetBool(args, "includePreviewPng", defaultValue: true);
        return BuildTemplatePayload(entry, changedSections, includePreview);
    }

    private async Task<object> McpUndoTemplateAsync(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        if (entry.History.Count == 0)
        {
            throw new InvalidOperationException($"История изменений шаблона «{entry.Name}» пуста – откатывать нечего.");
        }

        var requestedSteps = GetInt(args, "steps") ?? 1;
        if (requestedSteps < 1)
        {
            throw new InvalidOperationException("Параметр 'steps' должен быть целым числом >= 1.");
        }

        var count = Math.Clamp(requestedSteps, 1, entry.History.Count);
        var beforeUndo = entry.State;
        var targetEntry = entry.History[^count];
        var undoneSteps = entry.History
            .Skip(entry.History.Count - count)
            .Reverse()
            .Select(h => h.Label)
            .ToArray();

        entry.History.RemoveRange(entry.History.Count - count, count);
        entry.State = targetEntry.State;
        _lastManualPushTicks = 0;

        var changedSections = GetChangedSections(beforeUndo.Style, entry.State.Style);
        if (entry.Id == _activeId)
        {
            ApplyState(entry.State);
            Render();
        }

        _error = null;
        _notice = count == 1
            ? $"MCP: откат «{entry.Name}» ({targetEntry.Label})"
            : $"MCP: откат «{entry.Name}» на {count} шаг.";
        await PersistProfilesAsync();
        StateHasChanged();

        var includePreview = GetBool(args, "includePreviewPng", defaultValue: true);
        return BuildTemplatePayload(entry, changedSections, includePreview, undoneSteps);
    }

    private async Task<object> McpDuplicateTemplateAsync(JsonObject args)
    {
        var src = FindProfile(args, required: true)!;
        var requestedName = GetString(args, "newName")?.Trim();
        var copyName = string.IsNullOrWhiteSpace(requestedName)
            ? UniqueProfileName(src.Name + " копия")
            : UniqueProfileName(requestedName);

        var copy = new ProfileEntry { Id = NewId(), Name = copyName, State = src.State with { } };
        _profiles.Add(copy);

        if (GetBool(args, "activate", defaultValue: true))
        {
            _activeId = copy.Id;
            ApplyState(copy.State);
            Render();
        }

        _error = null;
        _notice = $"MCP: дублирован шаблон «{copy.Name}»";
        await PersistProfilesAsync();
        StateHasChanged();

        return BuildTemplatePayload(copy, changedSections: null, includePreview: true);
    }

    private async Task<object> McpRenameTemplateAsync(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        var newName = GetString(args, "newName")?.Trim();
        if (string.IsNullOrWhiteSpace(newName))
            throw new InvalidOperationException("Не указано новое имя шаблона (newName)");

        EnsureUniqueProfileName(newName, entry.Id);
        entry.Name = newName;
        _error = null;
        _notice = $"MCP: шаблон переименован в «{entry.Name}»";
        await PersistProfilesAsync();
        StateHasChanged();

        return BuildTemplatePayload(entry, changedSections: null, includePreview: false);
    }

    private async Task<object> McpDeleteTemplateAsync(JsonObject args)
    {
        if (_profiles.Count <= 1)
            throw new InvalidOperationException("Нельзя удалить последний оставшийся шаблон");

        var entry = FindProfile(args, required: true)!;
        var deletedName = entry.Name;
        var deletedId = entry.Id;

        _profiles.RemoveAll(p => p.Id == deletedId);
        if (_activeId == deletedId)
        {
            _activeId = _profiles[0].Id;
            ApplyState(_profiles[0].State);
            Render();
        }

        _error = null;
        _notice = $"MCP: удалён шаблон «{deletedName}»";
        await PersistProfilesAsync();
        StateHasChanged();

        return new
        {
            deletedId,
            deletedName,
            activeId = _activeId,
            activeName = _profiles.First(p => p.Id == _activeId).Name,
            remainingCount = _profiles.Count,
        };
    }

    private async Task<object> McpSetActiveTemplateAsync(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        _activeId = entry.Id;
        ApplyState(entry.State);
        Render();
        _error = null;
        _notice = $"MCP: выбран шаблон «{entry.Name}»";
        await PersistProfilesAsync();
        StateHasChanged();

        var includePreview = GetBool(args, "includePreviewPng", defaultValue: true);
        return BuildTemplatePayload(entry, changedSections: null, includePreview);
    }

    private async Task<object> McpResetTemplateStyleAsync(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        var beforeState = entry.State;
        var after = new BannerStyle();
        var changed = GetChangedSections(beforeState.Style, after);
        var nextState = beforeState with { Style = after };

        if (HasTemplateChanged(beforeState, nextState))
        {
            PushHistory(entry, DescribeChange("MCP: сброс стиля", beforeState, nextState), beforeState);
            _lastManualPushTicks = 0;
        }

        entry.State = nextState;
        if (entry.Id == _activeId)
        {
            ApplyState(entry.State);
            Render();
        }

        _error = null;
        _notice = $"MCP: сброшен стиль шаблона «{entry.Name}»";
        await PersistProfilesAsync();
        StateHasChanged();

        var includePreview = GetBool(args, "includePreviewPng", defaultValue: true);
        return BuildTemplatePayload(entry, changed, includePreview);
    }

    private object McpRenderBanner(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        var tempState = ApplyPartialPatch(entry.State, args, out _);
        var pngBase64 = RenderStateToBase64(tempState);
        return new
        {
            templateId = entry.Id,
            templateName = entry.Name,
            width = Math.Clamp(tempState.Width, 320, 3840),
            height = Math.Clamp(tempState.Height, 180, 2160),
            seed = tempState.Seed,
            previewPngBase64 = pngBase64,
        };
    }

    private ProfileEntry? FindProfile(JsonObject args, bool required)
    {
        var id = GetString(args, "id")?.Trim();
        var name = GetString(args, "name")?.Trim();

        ProfileEntry? found = null;
        if (!string.IsNullOrEmpty(id))
        {
            found = _profiles.FirstOrDefault(p => string.Equals(p.Id, id, StringComparison.OrdinalIgnoreCase));
        }

        if (found is null && !string.IsNullOrEmpty(name))
        {
            found = _profiles.FirstOrDefault(p => string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase));
        }

        if (found is null && string.IsNullOrEmpty(id) && string.IsNullOrEmpty(name))
        {
            found = _profiles.FirstOrDefault(p => p.Id == _activeId) ?? _profiles.FirstOrDefault();
        }

        if (found is null && required)
        {
            throw new InvalidOperationException(
                $"Шаблон не найден (id={id ?? "–"}, name={name ?? "–"}). Вызовите list_templates для списка доступных.");
        }

        return found;
    }

    private static readonly HashSet<string> AllowedSpecKeys = new(StringComparer.OrdinalIgnoreCase)
    {
        "title", "subtitle", "tagline", "seed", "width", "height", "transparent",
    };

    private static SavedState ApplyPartialPatch(SavedState current, JsonObject args, out IReadOnlyList<string> changedSections)
    {
        var next = current;

        if (TryGetPropertyIgnoreCase(args, "spec", out var specNode) && specNode is not null)
        {
            if (specNode is not JsonObject specObj)
                throw new InvalidOperationException("Поле 'spec' должно быть JSON-объектом.");

            foreach (var kv in specObj)
            {
                if (!AllowedSpecKeys.Contains(kv.Key))
                {
                    throw new InvalidOperationException(
                        $"Неизвестное поле spec '{kv.Key}'. Допустимые поля: title, subtitle, tagline, seed, width, height, transparent.");
                }
            }

            if (GetString(specObj, "title") is { } title)
                next = next with { Title = title };
            if (GetString(specObj, "subtitle") is { } subtitle)
                next = next with { Subtitle = subtitle };
            if (TryGetPropertyIgnoreCase(specObj, "tagline", out var tagNode))
                next = next with { Tagline = tagNode?.GetValue<string>() ?? "" };
            if (GetInt(specObj, "seed") is { } seed)
                next = next with { Seed = seed };
            if (GetInt(specObj, "width") is { } width)
                next = next with { Width = Math.Clamp(width, 320, 3840) };
            if (GetInt(specObj, "height") is { } height)
                next = next with { Height = Math.Clamp(height, 180, 2160) };
            if (TryGetPropertyIgnoreCase(specObj, "transparent", out var trNode) && trNode is not null)
                next = next with { Transparent = GetBool(specObj, "transparent", defaultValue: next.Transparent) };
        }

        var beforeStyle = next.Style;
        if (TryGetPropertyIgnoreCase(args, "style", out var styleNode) && styleNode is not null)
        {
            if (styleNode is not JsonObject stylePatch)
                throw new InvalidOperationException("Поле 'style' должно быть JSON-объектом.");

            var targetObj = JsonNode.Parse(beforeStyle.ToJson())!.AsObject();
            MergeJsonObjects(targetObj, stylePatch);
            var mergedStyle = BannerStyle.FromJson(targetObj.ToJsonString());
            ValidateStyleColors(mergedStyle);
            next = next with { Style = mergedStyle };
        }

        changedSections = GetChangedSections(beforeStyle, next.Style);
        return next;
    }

    private static void MergeJsonObjects(JsonObject target, JsonObject patch)
    {
        foreach (var kv in patch)
        {
            if (kv.Value is null)
                continue;

            var existingKey = target.Select(p => p.Key)
                .FirstOrDefault(k => string.Equals(k, kv.Key, StringComparison.OrdinalIgnoreCase));

            if (existingKey is null)
            {
                throw new InvalidOperationException(
                    $"Неизвестное поле или секция стиля '{kv.Key}'. Вызовите get_style_guide для списка секций и ручек.");
            }

            if (target[existingKey] is JsonObject targetChild)
            {
                if (kv.Value is not JsonObject patchChild)
                    throw new InvalidOperationException($"Секция стиля '{existingKey}' должна быть JSON-объектом.");

                MergeJsonObjects(targetChild, patchChild);
            }
            else
            {
                target[existingKey] = kv.Value.DeepClone();
            }
        }
    }

    private static void ValidateStyleColors(BannerStyle s)
    {
        StyleColor.Parse(s.Palette.GreenFaceTop);
        StyleColor.Parse(s.Palette.GreenFaceMid);
        StyleColor.Parse(s.Palette.GreenFaceBottom);
        StyleColor.Parse(s.Palette.GreenExtrude);
        StyleColor.Parse(s.Palette.WhiteFaceTop);
        StyleColor.Parse(s.Palette.WhiteFaceMid);
        StyleColor.Parse(s.Palette.WhiteFaceBottom);
        StyleColor.Parse(s.Palette.WhiteExtrude);
        StyleColor.Parse(s.Palette.BandTop);
        StyleColor.Parse(s.Palette.BandBottom);
        StyleColor.Parse(s.Palette.Smear);
        StyleColor.Parse(s.Palette.Plate);
        StyleColor.Parse(s.Palette.SubtitleText);
        StyleColor.Parse(s.Palette.TitleStroke);
        StyleColor.Parse(s.Palette.Chips);
        StyleColor.Parse(s.Palette.DarkSplatter);
        StyleColor.Parse(s.TitleFx.MainMottleColor);
        StyleColor.Parse(s.TitleFx.PrefixMottleColor);
        StyleColor.Parse(s.Plate.MottleColor);
        StyleColor.Parse(s.Smear.MottleColor);
        StyleColor.Parse(s.Band.MottleColor);
        StyleColor.Parse(s.Tagline.Color);
    }

    private static IReadOnlyList<string> GetChangedSections(BannerStyle before, BannerStyle after)
    {
        var changed = new List<string>();
        if (before.Palette != after.Palette) changed.Add(nameof(BannerStyle.Palette));
        if (before.Layout != after.Layout) changed.Add(nameof(BannerStyle.Layout));
        if (before.TitleFx != after.TitleFx) changed.Add(nameof(BannerStyle.TitleFx));
        if (before.Plate != after.Plate) changed.Add(nameof(BannerStyle.Plate));
        if (before.Smear != after.Smear) changed.Add(nameof(BannerStyle.Smear));
        if (before.Band != after.Band) changed.Add(nameof(BannerStyle.Band));
        if (before.Accents != after.Accents) changed.Add(nameof(BannerStyle.Accents));
        if (before.Tagline != after.Tagline) changed.Add(nameof(BannerStyle.Tagline));
        if (before.Logo != after.Logo) changed.Add(nameof(BannerStyle.Logo));
        if (before.Background != after.Background) changed.Add(nameof(BannerStyle.Background));
        return changed;
    }

    private object BuildTemplatePayload(
        ProfileEntry entry,
        IReadOnlyList<string>? changedSections,
        bool includePreview,
        IReadOnlyList<string>? undoneSteps = null)
    {
        var s = entry.State;
        return new
        {
            id = entry.Id,
            name = entry.Name,
            isActive = entry.Id == _activeId,
            changedSections = changedSections ?? [],
            undoneSteps = undoneSteps ?? [],
            historyCount = entry.History.Count,
            history = entry.History
                .AsEnumerable()
                .Reverse()
                .Select((h, idx) => new
                {
                    stepsBack = idx + 1,
                    label = h.Label,
                    timestamp = h.Timestamp,
                })
                .ToArray(),
            spec = new
            {
                title = s.Title,
                subtitle = s.Subtitle,
                tagline = s.Tagline ?? "",
                seed = s.Seed,
                width = s.Width,
                height = s.Height,
                transparent = s.Transparent,
            },
            style = s.Style,
            previewPngBase64 = includePreview ? RenderStateToBase64(s) : null,
        };
    }

    private string? RenderStateToBase64(SavedState s)
    {
        if (_typeface is null)
            return null;

        var spec = new BannerSpec
        {
            Title = string.IsNullOrWhiteSpace(s.Title) ? " " : s.Title,
            Subtitle = s.Subtitle ?? "",
            Tagline = string.IsNullOrWhiteSpace(s.Tagline) ? null : s.Tagline,
            Seed = s.Seed,
            Width = Math.Clamp(s.Width, 320, 3840),
            Height = Math.Clamp(s.Height, 180, 2160),
            Transparent = s.Transparent,
        };

        var png = new BannerRenderer(s.Style).RenderPng(spec, _typeface, _background, _logo);
        return Convert.ToBase64String(png);
    }

    private void EnsureUniqueProfileName(string desiredName, string excludeId)
    {
        if (_profiles.Any(p => p.Id != excludeId && string.Equals(p.Name, desiredName, StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException($"Шаблон с именем «{desiredName}» уже существует.");
        }
    }

    private string UniqueProfileName(string baseName)
    {
        if (_profiles.All(p => !string.Equals(p.Name, baseName, StringComparison.OrdinalIgnoreCase)))
            return baseName;

        for (var n = 2; ; n++)
        {
            var candidate = $"{baseName} ({n})";
            if (_profiles.All(p => !string.Equals(p.Name, candidate, StringComparison.OrdinalIgnoreCase)))
                return candidate;
        }
    }

    private static bool TryGetPropertyIgnoreCase(JsonObject obj, string key, out JsonNode? value)
    {
        foreach (var kv in obj)
        {
            if (string.Equals(kv.Key, key, StringComparison.OrdinalIgnoreCase))
            {
                value = kv.Value;
                return true;
            }
        }
        value = null;
        return false;
    }

    private static string? GetString(JsonObject obj, string key) =>
        TryGetPropertyIgnoreCase(obj, key, out var node) && node is not null ? node.GetValue<string>() : null;

    private static int? GetInt(JsonObject obj, string key)
    {
        if (!TryGetPropertyIgnoreCase(obj, key, out var node) || node is null)
            return null;
        if (node is JsonValue jv && jv.TryGetValue<int>(out var directInt))
            return directInt;
        if (node.GetValueKind() == JsonValueKind.String && int.TryParse(node.GetValue<string>(), out var parsed))
            return parsed;
        throw new InvalidOperationException($"Поле '{key}' должно быть целым числом.");
    }

    private static bool GetBool(JsonObject obj, string key, bool defaultValue)
    {
        if (!TryGetPropertyIgnoreCase(obj, key, out var node) || node is null)
            return defaultValue;
        if (node is JsonValue jv && jv.TryGetValue<bool>(out var directBool))
            return directBool;
        if (node.GetValueKind() == JsonValueKind.String && bool.TryParse(node.GetValue<string>(), out var parsed))
            return parsed;
        throw new InvalidOperationException($"Поле '{key}' должно быть булевым значением (true/false).");
    }

    private async Task ImportStyle(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(1024 * 1024);
            using var reader = new StreamReader(stream);
            _style = BannerStyle.FromJson(await reader.ReadToEndAsync());
            _error = null;
            Render();
            await CommitUiStateAsync("Импорт стиля");
        }
        catch (Exception ex)
        {
            _error = "Импорт стиля не удался: " + ex.Message;
        }
    }

    private sealed record SavedState
    {
        public string Title { get; init; } = "";
        public string Subtitle { get; init; } = "";
        public string? Tagline { get; init; }
        public int Seed { get; init; } = 290;
        public int Width { get; init; } = 1280;
        public int Height { get; init; } = 720;
        public bool Transparent { get; init; }
        public int RenderDebounceMs { get; init; } = 150;
        public BannerStyle Style { get; init; } = new();
    }

    private sealed record HistoryEntry
    {
        public string Label { get; init; } = "";
        public string Timestamp { get; init; } = "";
        public SavedState State { get; init; } = new();
    }

    private sealed class ProfileEntry
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public SavedState State { get; set; } = new();
        public List<HistoryEntry> History { get; set; } = [];
    }

    private sealed class ProfileStore
    {
        public string ActiveId { get; set; } = "";
        public List<ProfileEntry> Profiles { get; set; } = [];
    }

}
