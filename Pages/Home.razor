        </div>
    </div>
</div>

@code {
    private string _title = "290. ЛЕДОКОЛ XIX";
    private string _subtitle = "КОРОЛЬ МАШИННОГО ЗАЛА";
    private string _tagline = "";
    private int _seed = 290;
    private int _width = 1280;
    private int _height = 720;
    private bool _transparent;

    private BannerStyle _style = new();

    // TODO: картинки фона/лого держим только в памяти – в localStorage не кладём (квота ~5 МБ, фон легко её пробьёт). После перезагрузки – загрузить заново.
    private SKImage? _background;
    private SKImage? _logo;

    private SKTypeface? _typeface;
    private string? _imgSrc;
    private string? _exportHref;
    private string? _error;
    private string? _notice;

    private const string StorageKey = "banner-state-v1";
    private const string ProfilesKey = "banner-profiles-v1";
    private const int MaxHistorySteps = 20;
    private const long ManualCoalesceWindowMs = 1500;

    private List<ProfileEntry> _profiles = [];
    private string _activeId = "";
    private bool _mcpConnected;
    private bool _promptCopied;
    private DotNetObjectReference<Home>? _dotNetRef;
    private long _lastManualPushTicks;
    private string _lastManualPushProfileId = "";

    private int _renderDebounceMs = 150;
    private CancellationTokenSource? _renderDebounce;

    private IReadOnlyList<HistoryEntry> ActiveHistory =>
        _profiles.FirstOrDefault(p => p.Id == _activeId)?.History ?? [];

    protected override async Task OnInitializedAsync()
    {
        var bytes = await Http.GetByteArrayAsync("Bender-Black.otf");
        _typeface = SKTypeface.FromData(SKData.CreateCopy(bytes));
        await LoadStateAsync();
        Render();

        _dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("bannerMcp.bind", _dotNetRef, "ws://127.0.0.1:5219/ws");
        }
        catch
        {
            // Мост опционален – при ошибке JS-интеропа редактор продолжает работать автономно.
        }
    }

    public void Dispose()
    {
        _renderDebounce?.Cancel();
        _renderDebounce?.Dispose();
        _background?.Dispose();
        _logo?.Dispose();
        _ = JS.InvokeVoidAsync("bannerMcp.unbind");
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public void OnMcpConnectionChanged(bool connected)
    {
        _mcpConnected = connected;
        StateHasChanged();
    }

    private async Task CopyAgentPrompt()
    {
        try
        {
            await JS.InvokeAsync<bool>("bannerMcp.copyText", BuildAgentPrompt());
            _promptCopied = true;
            _notice = "Промпт для агента скопирован – вставьте его в чат агента";
            StateHasChanged();
            await Task.Delay(2200);
            _promptCopied = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _error = "Не удалось скопировать промпт: " + ex.Message;
        }
    }

    private string BuildAgentPrompt()
    {
        var baseUri = Nav.BaseUri.EndsWith('/') ? Nav.BaseUri : Nav.BaseUri + "/";
        var bridgeUrl = baseUri + "mcp-bridge.js";
        return $$"""
            Подключись к открытому в моём браузере сайту процедурного генератора баннеров ({{baseUri}}) через MCP для создания и редактирования шаблонов:

            1. Скачай скрипт локального MCP-моста (без внешних зависимостей) и запусти фоновый демон (команда выведет точный абсолютный путь `scriptPath`):
            node -e "const fs=require('fs'),p=require('path'),os=require('os'),cp=require('child_process'),d=p.join(os.homedir(),'.banner-mcp'),f=p.join(d,'mcp-bridge.js');fs.mkdirSync(d,{recursive:true});fs.writeFileSync(p.join(d,'package.json'),'{\"type\":\"commonjs\"}');fetch('{{bridgeUrl}}').then(r=>{if(!r.ok)throw new Error(r.status);return r.text()}).then(t=>{fs.writeFileSync(f,t);console.log(cp.execFileSync(process.execPath,[f,'--daemon'],{encoding:'utf8'}))})"

            2. Пропиши MCP-сервер `banner-generator` в конфигурацию агента, подставив полный абсолютный путь `scriptPath` из вывода шага 1 (без символа `~`, так как `spawn` на Windows его не раскрывает: stdio команда `node`, аргумент `[ "<scriptPath>" ]`, либо HTTP MCP `http://127.0.0.1:5219/mcp`).
            Если новые stdio MCP-серверы в текущей сессии подхватываются только после перезапуска, вызывай инструменты прямо сейчас через CLI по тому же абсолютному пути:
            `node "<scriptPath>" call <tool> '<json>' [--out preview.png]`

            Доступные инструменты MCP:
            - `list_templates` – список всех шаблонов на сайте и какой активен;
            - `get_template` – полный JSON шаблона (`spec` + `style`) и история шагов (`history`);
            - `get_style_guide` – описание всех 10 секций и ручек `BannerStyle` и дефолтных значений;
            - `create_template` – создать новый шаблон (можно клонировать `baseTemplateId`/`baseTemplateName` и передать частичный `spec`/`style`);
            - `update_template` – частично пропатчить `spec` и `style` шаблона (достаточно передать только меняемые секции/поля и краткий `summary` для истории шагов) с мгновенной перерисовкой в браузере;
            - `undo_template` – откатить изменения шаблона на 1 или несколько шагов назад (`steps`) по общей истории правок;
            - `duplicate_template`, `rename_template`, `delete_template`, `set_active_template`, `reset_template_style`, `render_banner`.

            После каждой правки проверяй возвращённый рендер PNG (или файл `--out preview.png`) и при необходимости докручивай параметры через `update_template` или откатывай неудачный шаг через `undo_template`. Проверь связь вызовом `list_templates` и напиши, какие шаблоны сейчас открыты на сайте.
            """;
    }

    private async Task Randomize()
    {
        _seed = Random.Shared.Next(1, 1_000_000);
        Render();
        await CommitUiStateAsync("Случайный seed");
    }

    private async Task ResetStyle()
    {
        _style = new();
        Render();
        await CommitUiStateAsync("Сброс стиля");
    }

    private Task UndoLastStepAsync() => UndoStepsAsync(1);

    private async Task UndoStepsAsync(int steps)
    {
        await FlushActiveProfileAsync();
        var active = _profiles.FirstOrDefault(p => p.Id == _activeId);
        if (active is null || active.History.Count == 0)
            return;

        var count = Math.Clamp(steps, 1, active.History.Count);
        var targetEntry = active.History[^count];
        active.History.RemoveRange(active.History.Count - count, count);
        active.State = targetEntry.State;
        _lastManualPushTicks = 0;

        ApplyState(active.State);
        _error = null;
        _notice = count == 1
            ? $"Откат: {targetEntry.Label}"
            : $"Откат на {count} шаг. ({targetEntry.Label})";
        Render();
        await PersistProfilesAsync();
    }

    private void ToggleTransparent()
    {
        _transparent = !_transparent;
        RequestRender();
    }

    private void OnDimsChanged()
    {
        _width = Math.Clamp(_width, 320, 3840);
        _height = Math.Clamp(_height, 180, 2160);
        RequestRender();
    }

    private void Apply(BannerStyle s)
    {
        _style = s;
        RequestRender();
    }

    private async void RequestRender()
    {
        _renderDebounce?.Cancel();
        _renderDebounce?.Dispose();
        var cts = new CancellationTokenSource();
        _renderDebounce = cts;

        try
        {
            await Task.Delay(Math.Max(0, _renderDebounceMs), cts.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        Render();
        await CommitUiStateAsync();
        StateHasChanged();
    }

    private void P(Func<BannerStyle.PaletteStyle, BannerStyle.PaletteStyle> f)
    {
        Apply(_style with { Palette = f(_style.Palette) });
    }

    private void L(Func<BannerStyle.LayoutStyle, BannerStyle.LayoutStyle> f)
    {
        Apply(_style with { Layout = f(_style.Layout) });
    }

    private void T(Func<BannerStyle.TitleFxStyle, BannerStyle.TitleFxStyle> f)
    {
        Apply(_style with { TitleFx = f(_style.TitleFx) });
    }

    private void Pl(Func<BannerStyle.PlateStyle, BannerStyle.PlateStyle> f)
    {
        Apply(_style with { Plate = f(_style.Plate) });
    }

    private void Sm(Func<BannerStyle.SmearStyle, BannerStyle.SmearStyle> f)
    {
        Apply(_style with { Smear = f(_style.Smear) });
    }

    private void B(Func<BannerStyle.BandStyle, BannerStyle.BandStyle> f)
    {
        Apply(_style with { Band = f(_style.Band) });
    }

    private void Ac(Func<BannerStyle.AccentsStyle, BannerStyle.AccentsStyle> f)
    {
        Apply(_style with { Accents = f(_style.Accents) });
    }

    private void Tg(Func<BannerStyle.TaglineStyle, BannerStyle.TaglineStyle> f)
    {
        Apply(_style with { Tagline = f(_style.Tagline) });
    }

    private void Bg(Func<BannerStyle.BackgroundStyle, BannerStyle.BackgroundStyle> f)
    {
        Apply(_style with { Background = f(_style.Background) });
    }

    private void Lg(Func<BannerStyle.LogoStyle, BannerStyle.LogoStyle> f)
    {
        Apply(_style with { Logo = f(_style.Logo) });
    }

    private async Task UploadBackground(InputFileChangeEventArgs e)
    {
        try
        {
            _background?.Dispose();
            _background = await DecodeImage(e.File);
            _error = null;
            Render();
            await CommitUiStateAsync();
        }
        catch (Exception ex)
        {
            _error = "Фон не удалось загрузить: " + ex.Message;
        }
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        try
        {
            _logo?.Dispose();
            _logo = await DecodeImage(e.File);
            if (!_style.Logo.Enabled)
                _style = _style with { Logo = _style.Logo with { Enabled = true } };
            _error = null;
            Render();
            await CommitUiStateAsync("Загрузка логотипа");
        }
        catch (Exception ex)
        {
            _error = "Лого не удалось загрузить: " + ex.Message;
        }
    }

    private void ClearBackground()
    {
        _background?.Dispose();
        _background = null;
        Render();
    }

    private void ClearLogo()
    {
        _logo?.Dispose();
        _logo = null;
        Render();
    }

    private static async Task<SKImage> DecodeImage(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(20 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return SKImage.FromEncodedData(ms.ToArray())
               ?? throw new InvalidOperationException("формат картинки не распознан");
    }

    private void Render()
    {
        if (_typeface is null)
            return;

        _exportHref = "data:application/json;charset=utf-8," + Uri.EscapeDataString(_style.ToJson());

        try
        {
            var spec = new BannerSpec
            {
                Title = string.IsNullOrWhiteSpace(_title) ? " " : _title,
                Subtitle = _subtitle ?? "",
                Tagline = string.IsNullOrWhiteSpace(_tagline) ? null : _tagline,
                Seed = _seed,
                Width = Math.Clamp(_width, 320, 3840),
                Height = Math.Clamp(_height, 180, 2160),
                Transparent = _transparent,
            };

            var png = new BannerRenderer(_style).RenderPng(spec, _typeface, _background, _logo);
            _imgSrc = "data:image/png;base64," + Convert.ToBase64String(png);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private SavedState CaptureState() => new()
    {
        Title = _title, Subtitle = _subtitle, Tagline = _tagline,
        Seed = _seed, Width = _width, Height = _height,
        Transparent = _transparent, RenderDebounceMs = _renderDebounceMs, Style = _style,
    };

    private void ApplyState(SavedState s)
    {
        _title = s.Title;
        _subtitle = s.Subtitle;
        _tagline = s.Tagline ?? "";
        _seed = s.Seed;
        _width = s.Width;
        _height = s.Height;
        _transparent = s.Transparent;
        _renderDebounceMs = s.RenderDebounceMs;
        _style = s.Style;
    }

    private ProfileEntry EnsureActiveProfile()
    {
        var active = _profiles.FirstOrDefault(p => p.Id == _activeId);
        if (active is null)
        {
            active = new ProfileEntry { Id = NewId(), Name = "Локальный", State = CaptureState() };
            _profiles.Add(active);
            _activeId = active.Id;
        }
        return active;
    }

    // Фиксирует ручные правки редактора в истории активного профиля и сохраняет реестр в localStorage.
    private async Task CommitUiStateAsync(string? explicitLabel = null)
    {
        var active = EnsureActiveProfile();
        var current = CaptureState();
        if (HasTemplateChanged(active.State, current))
        {
            var now = Environment.TickCount64;
            if (explicitLabel is null
                && _lastManualPushProfileId == active.Id
                && now - _lastManualPushTicks <= ManualCoalesceWindowMs
                && active.History.Count > 0)
            {
                var top = active.History[^1];
                if (!HasTemplateChanged(top.State, current))
                {
                    active.History.RemoveAt(active.History.Count - 1);
                }
                else
                {
                    active.History[^1] = top with
                    {
                        Label = DescribeChange("Ручная правка", top.State, current),
                        Timestamp = DateTime.Now.ToString("HH:mm:ss"),
                    };
                }
                _lastManualPushTicks = now;
            }
            else
            {
                var prefix = explicitLabel ?? "Ручная правка";
                PushHistory(active, DescribeChange(prefix, active.State, current), active.State);
                if (explicitLabel is null)
                {
                    _lastManualPushProfileId = active.Id;
                    _lastManualPushTicks = now;
                }
                else
                {
                    _lastManualPushTicks = 0;
                }
            }
        }

        active.State = current;
        await PersistProfilesAsync();
    }

    private async Task PersistProfilesAsync()
    {
        try
        {
            var store = new ProfileStore { ActiveId = _activeId, Profiles = _profiles };
            await JS.InvokeVoidAsync("localStorage.setItem", ProfilesKey, JsonSerializer.Serialize(store));
        }
        catch
        {
            // ponytail: localStorage может быть недоступен (private mode / quota / отключён) – тихо без сохранения
        }
    }

    private static void PushHistory(ProfileEntry profile, string label, SavedState previousState)
    {
        profile.History.Add(new HistoryEntry
        {
            Label = label,
            Timestamp = DateTime.Now.ToString("HH:mm:ss"),
            State = previousState,
        });
        while (profile.History.Count > MaxHistorySteps)
        {
            profile.History.RemoveAt(0);
        }
    }

    private static bool HasTemplateChanged(SavedState a, SavedState b) =>
        a.Title != b.Title
        || a.Subtitle != b.Subtitle
        || (a.Tagline ?? "") != (b.Tagline ?? "")
        || a.Seed != b.Seed
        || a.Width != b.Width
        || a.Height != b.Height
        || a.Transparent != b.Transparent
        || a.Style != b.Style;

    private static string DescribeChange(string prefix, SavedState before, SavedState after, string? customSummary = null)
    {
        var parts = new List<string>();
        if (before.Title != after.Title || before.Subtitle != after.Subtitle || (before.Tagline ?? "") != (after.Tagline ?? ""))
            parts.Add("текст");
        if (before.Seed != after.Seed)
            parts.Add("seed");
        if (before.Width != after.Width || before.Height != after.Height || before.Transparent != after.Transparent)
            parts.Add("кадр");
        parts.AddRange(GetChangedSections(before.Style, after.Style));

        var suffix = parts.Count > 0 ? $" ({string.Join(", ", parts)})" : "";
        if (!string.IsNullOrWhiteSpace(customSummary))
        {
            return $"MCP: {customSummary.Trim()}{suffix}";
        }
        return $"{prefix}{suffix}";
    }

    private async Task LoadStateAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", ProfilesKey);
            if (!string.IsNullOrEmpty(json)
                && JsonSerializer.Deserialize<ProfileStore>(json) is { Profiles.Count: > 0 } store)
            {
                _profiles = store.Profiles;
                _activeId = _profiles.Any(p => p.Id == store.ActiveId) ? store.ActiveId : _profiles[0].Id;
                ApplyState(_profiles.First(p => p.Id == _activeId).State);
                return;
            }

            // Миграция одиночного снимка banner-state-v1 → профиль «Локальный» (ничего не теряем).
            var legacy = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            var migrated = string.IsNullOrEmpty(legacy) ? null : JsonSerializer.Deserialize<SavedState>(legacy);
            SeedSingleProfile(migrated ?? CaptureState());
        }
        catch
        {
            // битый снимок или недоступное хранилище – один профиль из текущих дефолтов
            if (_profiles.Count == 0)
                SeedSingleProfile(CaptureState());
        }
    }

    private void SeedSingleProfile(SavedState state)
    {
        var entry = new ProfileEntry { Id = NewId(), Name = "Локальный", State = state };
        _profiles = [entry];
        _activeId = entry.Id;
        ApplyState(state);
    }

    private static string NewId() => Guid.NewGuid().ToString("N")[..8];

    private string NextProfileName()
    {
        for (var n = _profiles.Count + 1; ; n++)
        {
            var name = $"Профиль {n}";
            if (_profiles.All(p => !string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase)))
                return name;
        }
    }

    private async Task OnProfileSelected(ChangeEventArgs e)
    {
        var id = (string?)e.Value;
        if (string.IsNullOrEmpty(id) || id == _activeId)
            return;

        await FlushActiveProfileAsync();
        _activeId = id;
        ApplyState(_profiles.First(p => p.Id == id).State);
        Render();
        await PersistProfilesAsync();
    }

    private async Task NewProfile()
    {
        await FlushActiveProfileAsync();
        var entry = new ProfileEntry { Id = NewId(), Name = NextProfileName(), State = new() };
        _profiles.Add(entry);
        _activeId = entry.Id;
        ApplyState(entry.State);
        Render();
        await PersistProfilesAsync();
    }

    private async Task DuplicateProfile()
    {
        await FlushActiveProfileAsync();
        var src = _profiles.First(p => p.Id == _activeId);
        var copy = new ProfileEntry { Id = NewId(), Name = UniqueProfileName(src.Name + " копия"), State = src.State };
        _profiles.Add(copy);
        _activeId = copy.Id;
        Render();
        await PersistProfilesAsync();
    }

    private async Task RenameProfile()
    {
        await FlushActiveProfileAsync();
        var current = _profiles.FirstOrDefault(p => p.Id == _activeId);
        if (current is null)
            return;

        var name = await JS.InvokeAsync<string?>("prompt", "Имя профиля:", current.Name);
        if (string.IsNullOrWhiteSpace(name))
            return;

        var trimmed = name.Trim();
        if (_profiles.Any(p => p.Id != current.Id && string.Equals(p.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
        {
            _error = $"Профиль с именем «{trimmed}» уже существует";
            return;
        }

        current.Name = trimmed;
        _error = null;
        await PersistProfilesAsync();
    }

    private async Task DeleteProfile()
    {
        if (_profiles.Count <= 1)
            return;

        _profiles.RemoveAll(p => p.Id == _activeId);
        _activeId = _profiles[0].Id;
        _lastManualPushTicks = 0;
        ApplyState(_profiles[0].State);
        Render();
        await PersistProfilesAsync();
    }

    private static readonly JsonSerializerOptions McpJsonOptions = new(JsonSerializerDefaults.Web)
    {
        WriteIndented = false,
    };

    [JSInvokable]
    public async Task<string> InvokeMcpToolAsync(string tool, string argsJson)
    {
        try
        {
            var args = string.IsNullOrWhiteSpace(argsJson)
                ? new JsonObject()
                : JsonNode.Parse(argsJson)?.AsObject() ?? new JsonObject();

            // Синхронизируем текущие поля редактора в активный профиль перед любым чтением/правкой
            await FlushActiveProfileAsync();

            var response = tool switch
            {
                "list_templates" => McpListTemplates(),
                "get_template" => McpGetTemplate(args),
                "get_style_guide" => McpGetStyleGuide(),
                "create_template" => await McpCreateTemplateAsync(args),
                "update_template" => await McpUpdateTemplateAsync(args),
                "undo_template" => await McpUndoTemplateAsync(args),
                "duplicate_template" => await McpDuplicateTemplateAsync(args),
                "rename_template" => await McpRenameTemplateAsync(args),
                "delete_template" => await McpDeleteTemplateAsync(args),
                "set_active_template" => await McpSetActiveTemplateAsync(args),
                "reset_template_style" => await McpResetTemplateStyleAsync(args),
                "render_banner" => McpRenderBanner(args),
                _ => throw new InvalidOperationException($"Неизвестный инструмент MCP: {tool}"),
            };

            return JsonSerializer.Serialize(response, McpJsonOptions);
        }
        catch (Exception ex)
        {
            _error = "MCP: " + ex.Message;
            StateHasChanged();
            return JsonSerializer.Serialize(new { error = ex.Message }, McpJsonOptions);
        }
    }

    private async Task FlushActiveProfileAsync()
    {
        _renderDebounce?.Cancel();
        var active = _profiles.FirstOrDefault(p => p.Id == _activeId);
        if (active is null)
            return;

        var current = CaptureState();
        if (HasTemplateChanged(active.State, current))
        {
            PushHistory(active, DescribeChange("Ручная правка", active.State, current), active.State);
            active.State = current;
            Render();
            await PersistProfilesAsync();
            StateHasChanged();
        }
        _lastManualPushTicks = 0;
    }

    private object McpListTemplates() => new
    {
        activeId = _activeId,
        activeName = _profiles.FirstOrDefault(p => p.Id == _activeId)?.Name ?? "",
        count = _profiles.Count,
        templates = _profiles.Select(p => new
        {
            id = p.Id,
            name = p.Name,
            isActive = p.Id == _activeId,
            historyCount = p.History.Count,
            title = p.State.Title,
            subtitle = p.State.Subtitle,
            tagline = p.State.Tagline ?? "",
            seed = p.State.Seed,
            width = p.State.Width,
            height = p.State.Height,
            transparent = p.State.Transparent,
        }).ToArray(),
    };

    private object McpGetTemplate(JsonObject args)
    {
        var entry = FindProfile(args, required: true)!;
        var includePreview = GetBool(args, "includePreviewPng", defaultValue: false);
        return BuildTemplatePayload(entry, changedSections: null, includePreview);
    }

