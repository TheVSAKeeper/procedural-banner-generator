@page "/"

<PageTitle>Процедурный генератор баннеров</PageTitle>

<div class="console">
    <div class="masthead">
        <h1>Генератор <b>баннеров</b></h1>
        <div class="hazard"></div>
    </div>

    <div class="workspace">
        <BannerStage ImageSrc="@_imgSrc"
                     ExportHref="@_exportHref"
                     IsReady="@(_typeface is not null)"
                     Error="@_error"
                     Notice="@_notice"
                     FontError="@_fontError"
                     LoadingFont="@_loadingFont"
                     OnRetryFont="LoadFontAsync"
                     OnDismissNotice="DismissNotice"
                     History="@ActiveHistory"
                     OnRender="Render"
                     OnRandomize="Randomize"
                     OnUndoLastStep="UndoLastStepAsync"
                     OnResetStyle="ResetStyle"
                     OnImportStyle="ImportStyle" />

        <div class="controls">
            <ProfilePanel Profiles="@Profiles"
                          ActiveId="@ActiveId"
                          History="@ActiveHistory"
                          PreserveTextOnSwitch="@profiles.PreserveTextOnSwitch"
                          PreserveTextOnSwitchChanged="profiles.SetPreserveTextAsync"
                          McpConnected="@_mcpConnected"
                          PromptCopied="@_promptCopied"
                          AgentPrompt="@AgentPrompt"
                          OnSelectProfile="SelectProfileAsync"
                          OnNewProfile="NewProfile"
                          OnRenameProfile="RenameProfile"
                          OnDuplicateProfile="DuplicateProfile"
                          OnDeleteProfile="DeleteProfile"
                          OnCopyAgentPrompt="CopyAgentPrompt"
                          OnUndoSteps="UndoStepsAsync" />

            <SpecPanel @bind-Title="_title"
                       @bind-Subtitle="_subtitle"
                       @bind-Tagline="_tagline"
                       @bind-Seed="_seed"
                       @bind-Width="_width"
                       @bind-Height="_height"
                       @bind-RenderDebounceMs="_renderDebounceMs"
                       @bind-Transparent="_transparent"
                       HasBackground="@(Background is not null)"
                       OnChange="RequestRender" />

            <section class="panel">
                <span class="module-head">Фон и логотип</span>
                <p class="hint">Картинки относятся только к текущему профилю и хранятся до перезагрузки страницы.</p>
                <div class="image-actions">
                    <label class="btn btn-ghost">
                        <Icon Name="image" />
                        @(Background is null ? "Загрузить фон" : "Сменить фон")
                        <InputFile OnChange="UploadBackground" accept="image/*" class="visually-hidden-file" />
                    </label>
                    @if (Background is not null)
                    {
                        <button type="button" class="btn-danger" @onclick="ClearBackground">Убрать фон</button>
                    }
                    <label class="btn btn-ghost">
                        <Icon Name="image" />
                        @(Logo is null ? "Загрузить логотип" : "Сменить логотип")
                        <InputFile OnChange="UploadLogo" accept="image/*" class="visually-hidden-file" />
                    </label>
                    @if (Logo is not null)
                    {
                        <button type="button" class="btn-danger" @onclick="ClearLogo">Убрать логотип</button>
                    }
                </div>
            </section>

            <StyleCalibrationPanel @bind-Style="_style"
                                   @bind-Style:after="RequestRender" />
        </div>
    </div>
</div>
