<div class="stage @(FocusLayout ? "stage-focus" : null)">
    @if (FocusLayout)
    {
        @Toolbar
    }
    <section class="monitor">
        <div class="monitor-heading">
            <h2 class="module-head">Выходной кадр</h2>
            @if (CompactPreview)
            {
                <button type="button"
                        class="btn-ghost preview-toggle"
                        aria-controls="banner-preview"
                        aria-expanded="@(!_previewCollapsed ? "true" : "false")"
                        @onclick="() => _previewCollapsed = !_previewCollapsed">
                    @(_previewCollapsed ? "Показать превью" : "Свернуть превью")
                </button>
            }
        </div>
        <div id="banner-preview" class="monitor-screen @(CompactPreview && _previewCollapsed ? "preview-collapsed" : null)">
            @if (ImageSrc is not null)
            {
                <img class="preview"
                     src="@ImageSrc"
                     alt="Баннер" />
            }
            else
            {
                <div class="monitor-empty">– нет сигнала –</div>
            }
        </div>
        @if (FontError is not null)
        {
            <p class="status err" role="alert">@FontError</p>
            <button type="button" class="btn-ghost" @onclick="OnRetryFont">Повторить загрузку шрифта</button>
        }
        else if (!IsReady)
        {
            <p class="status"
               role="status"
               aria-live="polite">Инициализация шрифта…</p>
        }
        else if (RenderPending)
        {
            <p class="status" role="status">Кадр обновляется…</p>
        }
        else if (Error is not null)
        {
            <p class="status err"
               role="alert">@Error</p>
        }
        else if (Notice is not null)
        {
            <p class="status"
               role="status"
               aria-live="polite">@Notice
                <button type="button" class="btn-ghost notice-close" @onclick="OnDismissNotice" aria-label="Закрыть уведомление"><Icon Name="x" /></button>
            </p>
        }
    </section>

    @if (!FocusLayout)
    {
        @Toolbar
    }
</div>

@code {
    private RenderFragment Toolbar => @<section class="toolbar">
        <h2 class="module-head">Действия</h2>
        <div class="actions stage-actions">
            <button type="button" class="btn btn-primary" @onclick="OnDownload" disabled="@(!IsReady)">
                <Icon Name="download" />
                Скачать PNG
            </button>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnRender"
                    disabled="@(!IsReady)"
                    title="Перерисовать баннер с текущими параметрами">
                <Icon Name="play" />
                Обновить
            </button>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnRandomize"
                    disabled="@(!IsReady)"
                    title="Новый случайный seed – меняет рисунок потёртостей и брызг">
                <Icon Name="dices" />
                Случайный вид
            </button>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnUndoLastStep"
                    disabled="@(!IsReady || History.Count == 0)"
                    title="@(History.Count > 0 ? $"Откатить: {History[^1].Label}" : "История изменений этого шаблона пуста")">
                <Icon Name="undo" />
                Откатить <span class="undo-count">(@History.Count)</span>
            </button>
            @if (ShowStyleActions)
            {
                @if (ExportHref is not null)
                {
                    <a class="btn btn-ghost"
                       download="banner-style.json"
                       href="@ExportHref"
                       title="Сохранить текущие настройки стиля в файл JSON">
                        <Icon Name="save" />
                        Сохранить стиль</a>
                }
                <label class="btn btn-ghost"
                       title="Загрузить настройки стиля из ранее сохранённого файла JSON">
                    <Icon Name="upload" />
                    Загрузить стиль
                    <InputFile OnChange="OnImportStyle"
                               accept=".json,application/json"
                               class="visually-hidden-file" />
                </label>
                <button type="button"
                        class="btn-danger reset-style"
                        @onclick="OnResetStyle"
                        disabled="@(!IsReady)"
                        title="Вернуть все настройки стиля к значениям по умолчанию">
                    <Icon Name="rotate-ccw" />
                    Сбросить стиль
                </button>
            }
            @if (CanRedo)
            {
                <button type="button" class="btn-ghost redo-action" @onclick="OnRedo">
                    Повторить отменённое
                </button>
            }
        </div>
    </section>;
}
