<div class="stage @(FocusLayout ? "stage-focus" : null)">
    <section class="monitor">
        <span class="module-head">Выходной кадр</span>
        <div class="monitor-screen">
            @if (ImageSrc is not null)
            {
                <img class="preview"
                     src="@ImageSrc"
                     alt="Баннер" />
            }
            else
            {
                <div class="monitor-empty">– нет сигнала –</div>
            }
        </div>
        @if (FontError is not null)
        {
            <p class="status err" role="alert">@FontError</p>
            <button type="button" class="btn-ghost" disabled="@LoadingFont" @onclick="OnRetryFont">Повторить загрузку шрифта</button>
        }
        else if (!IsReady)
        {
            <p class="status"
               role="status"
               aria-live="polite">Инициализация шрифта…</p>
        }
        else if (Error is not null)
        {
            <p class="status err"
               role="alert">@Error</p>
        }
        else if (Notice is not null)
        {
            <p class="status"
               role="status"
               aria-live="polite">@Notice
                <button type="button" class="btn-ghost notice-close" @onclick="OnDismissNotice" aria-label="Закрыть уведомление"><Icon Name="x" /></button>
            </p>
        }
    </section>

    <section class="toolbar">
        <span class="module-head">Действия</span>
        <div class="actions stage-actions">
            <a class="btn btn-primary @(ImageSrc is null ? "disabled" : null)"
               download="banner.png"
               href="@ImageSrc"
               aria-disabled="@(ImageSrc is null ? "true" : "false")"
               tabindex="@(ImageSrc is null ? -1 : 0)"
               title="Скачать готовый баннер картинкой PNG">
                <Icon Name="download" />
                Скачать PNG</a>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnRender"
                    disabled="@(!IsReady)"
                    title="Перерисовать баннер с текущими параметрами">
                <Icon Name="play" />
                Обновить
            </button>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnRandomize"
                    disabled="@(!IsReady)"
                    title="Новый случайный seed – меняет рисунок потёртостей и брызг">
                <Icon Name="dices" />
                Случайный вид
            </button>
            <button type="button"
                    class="btn-ghost"
                    @onclick="OnUndoLastStep"
                    disabled="@(!IsReady || History.Count == 0)"
                    title="@(History.Count > 0 ? $"Откатить: {History[^1].Label}" : "История изменений этого шаблона пуста")">
                <Icon Name="undo" />
                Откатить <span class="undo-count">(@History.Count)</span>
            </button>
            @if (ShowStyleActions)
            {
                @if (ExportHref is not null)
                {
                    <a class="btn btn-ghost"
                       download="banner-style.json"
                       href="@ExportHref"
                       title="Сохранить текущие настройки стиля в файл JSON">
                        <Icon Name="save" />
                        Сохранить стиль</a>
                }
                <label class="btn btn-ghost"
                       title="Загрузить настройки стиля из ранее сохранённого файла JSON">
                    <Icon Name="upload" />
                    Загрузить стиль
                    <InputFile OnChange="OnImportStyle"
                               accept=".json,application/json"
                               class="visually-hidden-file" />
                </label>
                <button type="button"
                        class="btn-danger reset-style"
                        @onclick="OnResetStyle"
                        disabled="@(!IsReady)"
                        title="Вернуть все настройки стиля к значениям по умолчанию">
                    <Icon Name="rotate-ccw" />
                    Сбросить стиль
                </button>
            }
        </div>
    </section>
</div>
