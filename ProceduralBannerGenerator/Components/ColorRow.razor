<div class="prow crow">
    <span class="pname">@Label</span>
    <input type="color"
           value="@Rgb"
           @oninput="OnColor"
           aria-label="@Label" />
    <input type="range"
           min="0"
           max="255"
           step="1"
           value="@Alpha"
           @oninput="OnAlpha"
           aria-label="@($"{Label}: прозрачность")" />
    <input class="phex" value="@_hex" @oninput="OnHex" aria-label="@($"{Label}: HEX/RGBA")" aria-invalid="@(_hexError is not null ? "true" : "false")" />
    @if (_hexError is not null)
    {
        <span class="validation-message" role="alert">@_hexError</span>
    }
</div>
