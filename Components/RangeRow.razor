<div class="prow">
    <span class="pname">@Label</span>
    <input type="range"
           min="@Fmt(Min)"
           max="@Fmt(Max)"
           step="@Fmt(Step)"
           value="@Fmt(Value)"
           @oninput="OnInput"
           aria-label="@Label" />
    <input class="pnum"
           type="number"
           min="@Fmt(Min)"
           max="@Fmt(Max)"
           step="@Fmt(Step)"
           value="@Fmt(Value)"
           @oninput="OnInput"
           aria-label="@Label" />
</div>
