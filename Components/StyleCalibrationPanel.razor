<details class="adv">
    <summary>Расширенная калибровка стиля</summary>
    <div class="adv-body">

        <details class="sec">
            <summary>Палитра</summary>
            <ColorRow Label="Грань зелёного – верх"
                      Value="@Style.Palette.GreenFaceTop"
                      ValueChanged="v => P(p => p with { GreenFaceTop = v })" />
            <ColorRow Label="Грань зелёного – середина"
                      Value="@Style.Palette.GreenFaceMid"
                      ValueChanged="v => P(p => p with { GreenFaceMid = v })" />
            <ColorRow Label="Грань зелёного – низ"
                      Value="@Style.Palette.GreenFaceBottom"
                      ValueChanged="v => P(p => p with { GreenFaceBottom = v })" />
            <ColorRow Label="Экструзия зелёного"
                      Value="@Style.Palette.GreenExtrude"
                      ValueChanged="v => P(p => p with { GreenExtrude = v })" />
            <ColorRow Label="Грань белого – верх"
                      Value="@Style.Palette.WhiteFaceTop"
                      ValueChanged="v => P(p => p with { WhiteFaceTop = v })" />
            <ColorRow Label="Грань белого – середина"
                      Value="@Style.Palette.WhiteFaceMid"
                      ValueChanged="v => P(p => p with { WhiteFaceMid = v })" />
            <ColorRow Label="Грань белого – низ"
                      Value="@Style.Palette.WhiteFaceBottom"
                      ValueChanged="v => P(p => p with { WhiteFaceBottom = v })" />
            <ColorRow Label="Экструзия белого"
                      Value="@Style.Palette.WhiteExtrude"
                      ValueChanged="v => P(p => p with { WhiteExtrude = v })" />
            <ColorRow Label="Полоса – верх"
                      Value="@Style.Palette.BandTop"
                      ValueChanged="v => P(p => p with { BandTop = v })" />
            <ColorRow Label="Полоса – низ"
                      Value="@Style.Palette.BandBottom"
                      ValueChanged="v => P(p => p with { BandBottom = v })" />
            <ColorRow Label="Подмазка под номером"
                      Value="@Style.Palette.Smear"
                      ValueChanged="v => P(p => p with { Smear = v })" />
            <ColorRow Label="Плашка"
                      Value="@Style.Palette.Plate"
                      ValueChanged="v => P(p => p with { Plate = v })" />
            <ColorRow Label="Текст подзаголовка"
                      Value="@Style.Palette.SubtitleText"
                      ValueChanged="v => P(p => p with { SubtitleText = v })" />
            <ColorRow Label="Обводка заголовка"
                      Value="@Style.Palette.TitleStroke"
                      ValueChanged="v => P(p => p with { TitleStroke = v })" />
            <ColorRow Label="Чипсы"
                      Value="@Style.Palette.Chips"
                      ValueChanged="v => P(p => p with { Chips = v })" />
            <ColorRow Label="Тёмные брызги"
                      Value="@Style.Palette.DarkSplatter"
                      ValueChanged="v => P(p => p with { DarkSplatter = v })" />
        </details>

        <details class="sec">
            <summary>Раскладка</summary>
            <RangeRow Label="Кегль заголовка"
                      Min="0"
                      Max="0.2f"
                      Step="0.001f"
                      Value="@Style.Layout.TitleSizeFraction"
                      ValueChanged="v => L(s => s with { TitleSizeFraction = v })" />
            <RangeRow Label="Макс. ширина заголовка"
                      Min="0.2f"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Layout.MaxTitleWidthFraction"
                      ValueChanged="v => L(s => s with { MaxTitleWidthFraction = v })" />
            <RangeRow Label="Конденс заголовка"
                      Min="0.5f"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Layout.TitleScaleX"
                      ValueChanged="v => L(s => s with { TitleScaleX = v })" />
            <RangeRow Label="Базовая линия заголовка"
                      Min="0"
                      Max="1"
                      Step="0.005f"
                      Value="@Style.Layout.TitleBaselineFraction"
                      ValueChanged="v => L(s => s with { TitleBaselineFraction = v })" />
            <RangeRow Label="Кегль подзаголовка"
                      Min="0.1f"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Layout.SubtitleSizeFactor"
                      ValueChanged="v => L(s => s with { SubtitleSizeFactor = v })" />
            <RangeRow Label="Конденс подзаголовка"
                      Min="0.5f"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Layout.SubtitleScaleX"
                      ValueChanged="v => L(s => s with { SubtitleScaleX = v })" />
            <RangeRow Label="Смещение подзаголовка"
                      Min="0"
                      Max="2"
                      Step="0.01f"
                      Value="@Style.Layout.SubtitleBaselineOffsetFactor"
                      ValueChanged="v => L(s => s with { SubtitleBaselineOffsetFactor = v })" />
            <RangeRow Label="Наклон блока, °"
                      Min="-15"
                      Max="15"
                      Step="0.1f"
                      Value="@Style.Layout.RotationDegrees"
                      ValueChanged="v => L(s => s with { RotationDegrees = v })" />
            <RangeRow Label="Боковые поля плашки"
                      Min="0"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Layout.PlateSidePaddingFactor"
                      ValueChanged="v => L(s => s with { PlateSidePaddingFactor = v })" />
            <RangeRow Label="Верхнее поле плашки"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Layout.PlateTopPaddingFactor"
                      ValueChanged="v => L(s => s with { PlateTopPaddingFactor = v })" />
            <RangeRow Label="Низ плашки"
                      Min="0"
                      Max="2"
                      Step="0.01f"
                      Value="@Style.Layout.PlateBottomFactor"
                      ValueChanged="v => L(s => s with { PlateBottomFactor = v })" />
            <RangeRow Label="Высота полосы"
                      Min="0"
                      Max="3"
                      Step="0.01f"
                      Value="@Style.Layout.BandHeightFactor"
                      ValueChanged="v => L(s => s with { BandHeightFactor = v })" />
            <RangeRow Label="Левое поле полосы"
                      Min="0"
                      Max="3"
                      Step="0.01f"
                      Value="@Style.Layout.BandLeftPaddingFactor"
                      ValueChanged="v => L(s => s with { BandLeftPaddingFactor = v })" />
            <RangeRow Label="Правое поле полосы"
                      Min="0"
                      Max="3"
                      Step="0.01f"
                      Value="@Style.Layout.BandRightPaddingFactor"
                      ValueChanged="v => L(s => s with { BandRightPaddingFactor = v })" />
        </details>

        <details class="sec">
            <summary>3D-текст</summary>
            <RangeRow Label="Глубина экструзии"
                      Min="0"
                      Max="0.3f"
                      Step="0.005f"
                      Value="@Style.TitleFx.ExtrudeDepthFactor"
                      ValueChanged="v => T(s => s with { ExtrudeDepthFactor = v })" />
            <RangeRow Label="Наклон экструзии"
                      Min="-2"
                      Max="2"
                      Step="0.05f"
                      Value="@Style.TitleFx.ExtrudeStepX"
                      ValueChanged="v => T(s => s with { ExtrudeStepX = v })" />
            <RangeRow Label="Толщина обводки"
                      Min="0"
                      Max="0.1f"
                      Step="0.001f"
                      Value="@Style.TitleFx.StrokeWidthFactor"
                      ValueChanged="v => T(s => s with { StrokeWidthFactor = v })" />
            <RangeRow Label="Средняя точка градиента"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.TitleFx.FaceGradientMidStop"
                      ValueChanged="v => T(s => s with { FaceGradientMidStop = v })" />
            <ColorRow Label="Зерно белых букв"
                      Value="@Style.TitleFx.MainMottleColor"
                      ValueChanged="v => T(s => s with { MainMottleColor = v })" />
            <ColorRow Label="Зерно зелёного номера"
                      Value="@Style.TitleFx.PrefixMottleColor"
                      ValueChanged="v => T(s => s with { PrefixMottleColor = v })" />
            <RangeRow Label="Плотность зерна"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.TitleFx.MottleDensity"
                      ValueChanged="v => T(s => s with { MottleDensity = v })" />
            <RangeRow Label="Размер зерна"
                      Min="0"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.TitleFx.MottleMaxRadiusFactor"
                      ValueChanged="v => T(s => s with { MottleMaxRadiusFactor = v })" />
            <RangeRow Label="Плотность выгрызов"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.TitleFx.DistressDensity"
                      ValueChanged="v => T(s => s with { DistressDensity = v })" />
        </details>

        <details class="sec">
            <summary>Плашка</summary>
            <RangeRow Label="Рваность краёв"
                      Min="0"
                      Max="0.3f"
                      Step="0.005f"
                      Value="@Style.Plate.EdgeAmpFactor"
                      ValueChanged="v => Pl(s => s with { EdgeAmpFactor = v })" />
            <RangeRow Label="Рваность торцов"
                      Min="0"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.Plate.EndAmpFactor"
                      ValueChanged="v => Pl(s => s with { EndAmpFactor = v })" />
            <RangeRow Label="Зубья слева"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Plate.TeethLeftFactor"
                      ValueChanged="v => Pl(s => s with { TeethLeftFactor = v })" />
            <RangeRow Label="Зубья справа"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Plate.TeethRightFactor"
                      ValueChanged="v => Pl(s => s with { TeethRightFactor = v })" />
            <ColorRow Label="Неравномерность краски"
                      Value="@Style.Plate.MottleColor"
                      ValueChanged="v => Pl(s => s with { MottleColor = v })" />
            <RangeRow Label="Кол-во пятен"
                      Min="0"
                      Max="40"
                      Step="1"
                      Value="@Style.Plate.MottleCount"
                      ValueChanged="v => Pl(s => s with { MottleCount = (int)MathF.Round(v) })" />
            <RangeRow Label="Размер пятен"
                      Min="0"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Plate.MottleMaxRadiusFactor"
                      ValueChanged="v => Pl(s => s with { MottleMaxRadiusFactor = v })" />
            <RangeRow Label="Плотность выгрызов"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Plate.DistressDensity"
                      ValueChanged="v => Pl(s => s with { DistressDensity = v })" />
            <RangeRow Label="Тень – смещение Y"
                      Min="0"
                      Max="30"
                      Step="1"
                      Value="@Style.Plate.ShadowOffsetY"
                      ValueChanged="v => Pl(s => s with { ShadowOffsetY = v })" />
            <RangeRow Label="Тень – блюр"
                      Min="0"
                      Max="30"
                      Step="1"
                      Value="@Style.Plate.ShadowBlur"
                      ValueChanged="v => Pl(s => s with { ShadowBlur = v })" />
            <RangeRow Label="Тень – альфа"
                      Min="0"
                      Max="255"
                      Step="1"
                      Value="@Style.Plate.ShadowAlpha"
                      ValueChanged="v => Pl(s => s with { ShadowAlpha = (int)MathF.Round(v) })" />
        </details>

        <details class="sec">
            <summary>Подмазка под номером</summary>
            <label class="prow"><span class="pname">Включена</span><input type="checkbox"
                                                                          checked="@Style.Smear.Enabled"
                                                                          @onchange="e => Sm(s => s with { Enabled = (bool)e.Value! })" /></label>
            <RangeRow Label="Вынос влево"
                      Min="0"
                      Max="2"
                      Step="0.01f"
                      Value="@Style.Smear.LeftExtendFactor"
                      ValueChanged="v => Sm(s => s with { LeftExtendFactor = v })" />
            <RangeRow Label="Вынос вверх"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Smear.TopExtendFactor"
                      ValueChanged="v => Sm(s => s with { TopExtendFactor = v })" />
            <RangeRow Label="Запас справа"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Smear.RightPadFactor"
                      ValueChanged="v => Sm(s => s with { RightPadFactor = v })" />
            <RangeRow Label="Низ ниже базовой линии"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Smear.BaselineDropFactor"
                      ValueChanged="v => Sm(s => s with { BaselineDropFactor = v })" />
            <RangeRow Label="Рваность краёв"
                      Min="0"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.Smear.EdgeAmpFactor"
                      ValueChanged="v => Sm(s => s with { EdgeAmpFactor = v })" />
            <RangeRow Label="Рваность торцов"
                      Min="0"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.Smear.EndAmpFactor"
                      ValueChanged="v => Sm(s => s with { EndAmpFactor = v })" />
            <RangeRow Label="Зубья"
                      Min="0"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Smear.TeethFactor"
                      ValueChanged="v => Sm(s => s with { TeethFactor = v })" />
            <ColorRow Label="Тёмное зерно"
                      Value="@Style.Smear.MottleColor"
                      ValueChanged="v => Sm(s => s with { MottleColor = v })" />
            <RangeRow Label="Плотность зерна"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Smear.MottleDensity"
                      ValueChanged="v => Sm(s => s with { MottleDensity = v })" />
            <RangeRow Label="Размер зерна"
                      Min="0"
                      Max="0.3f"
                      Step="0.005f"
                      Value="@Style.Smear.MottleMaxRadiusFactor"
                      ValueChanged="v => Sm(s => s with { MottleMaxRadiusFactor = v })" />
            <RangeRow Label="Плотность выгрызов"
                      Min="0"
                      Max="5"
                      Step="0.05f"
                      Value="@Style.Smear.DistressDensity"
                      ValueChanged="v => Sm(s => s with { DistressDensity = v })" />
        </details>

        <details class="sec">
            <summary>Полоса</summary>
            <RangeRow Label="Рваность краёв"
                      Min="0"
                      Max="0.3f"
                      Step="0.005f"
                      Value="@Style.Band.EdgeAmpFactor"
                      ValueChanged="v => B(s => s with { EdgeAmpFactor = v })" />
            <RangeRow Label="Рваность торцов"
                      Min="0"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.Band.EndAmpFactor"
                      ValueChanged="v => B(s => s with { EndAmpFactor = v })" />
            <RangeRow Label="Зубья слева"
                      Min="0"
                      Max="2"
                      Step="0.01f"
                      Value="@Style.Band.TeethLeftFactor"
                      ValueChanged="v => B(s => s with { TeethLeftFactor = v })" />
            <RangeRow Label="Зубья справа"
                      Min="0"
                      Max="3"
                      Step="0.01f"
                      Value="@Style.Band.TeethRightFactor"
                      ValueChanged="v => B(s => s with { TeethRightFactor = v })" />
            <ColorRow Label="Зерно полосы"
                      Value="@Style.Band.MottleColor"
                      ValueChanged="v => B(s => s with { MottleColor = v })" />
            <RangeRow Label="Плотность зерна"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Band.MottleDensity"
                      ValueChanged="v => B(s => s with { MottleDensity = v })" />
            <RangeRow Label="Размер зерна"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Band.MottleMaxRadiusFactor"
                      ValueChanged="v => B(s => s with { MottleMaxRadiusFactor = v })" />
            <RangeRow Label="Плотность выгрызов"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Band.DistressDensity"
                      ValueChanged="v => B(s => s with { DistressDensity = v })" />
            <RangeRow Label="Потёртость подзаголовка"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Band.SubtitleDistressDensity"
                      ValueChanged="v => B(s => s with { SubtitleDistressDensity = v })" />
        </details>

        <details class="sec">
            <summary>Акценты</summary>
            <RangeRow Label="Чипсы слева"
                      Min="0"
                      Max="30"
                      Step="1"
                      Value="@Style.Accents.ChipsLeftCount"
                      ValueChanged="v => Ac(s => s with { ChipsLeftCount = (int)MathF.Round(v) })" />
            <RangeRow Label="Чипсы справа"
                      Min="0"
                      Max="30"
                      Step="1"
                      Value="@Style.Accents.ChipsRightCount"
                      ValueChanged="v => Ac(s => s with { ChipsRightCount = (int)MathF.Round(v) })" />
            <RangeRow Label="Разброс чипсов"
                      Min="0"
                      Max="60"
                      Step="1"
                      Value="@Style.Accents.ChipsSpread"
                      ValueChanged="v => Ac(s => s with { ChipsSpread = v })" />
            <RangeRow Label="Зелёная крошка"
                      Min="0"
                      Max="60"
                      Step="1"
                      Value="@Style.Accents.SplatterGreenCount"
                      ValueChanged="v => Ac(s => s with { SplatterGreenCount = (int)MathF.Round(v) })" />
            <RangeRow Label="Тёмные брызги"
                      Min="0"
                      Max="60"
                      Step="1"
                      Value="@Style.Accents.SplatterDarkCount"
                      ValueChanged="v => Ac(s => s with { SplatterDarkCount = (int)MathF.Round(v) })" />
        </details>

        <details class="sec">
            <summary>Третья строка</summary>
            <label class="prow"><span class="pname">Включена</span><input type="checkbox"
                                                                          checked="@Style.Tagline.Enabled"
                                                                          @onchange="e => Tg(s => s with { Enabled = (bool)e.Value! })" /></label>
            <RangeRow Label="Кегль"
                      Min="0.1f"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Tagline.SizeFactor"
                      ValueChanged="v => Tg(s => s with { SizeFactor = v })" />
            <ColorRow Label="Цвет"
                      Value="@Style.Tagline.Color"
                      ValueChanged="v => Tg(s => s with { Color = v })" />
            <RangeRow Label="Отступ от подзаголовка"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Tagline.BaselineGapFactor"
                      ValueChanged="v => Tg(s => s with { BaselineGapFactor = v })" />
            <RangeRow Label="Конденс"
                      Min="0.5f"
                      Max="1.5f"
                      Step="0.01f"
                      Value="@Style.Tagline.ScaleX"
                      ValueChanged="v => Tg(s => s with { ScaleX = v })" />
            <RangeRow Label="Потёртость"
                      Min="0"
                      Max="3"
                      Step="0.05f"
                      Value="@Style.Tagline.DistressDensity"
                      ValueChanged="v => Tg(s => s with { DistressDensity = v })" />
        </details>

        <details class="sec">
            <summary>Фон-картинка</summary>
            <p class="hint">Загрузите свою картинку – она заменит подложку-градиент. Ручки ниже действуют только при загруженном фоне.</p>
            <div class="row">
                <label class="btn btn-ghost"
                       title="Своя картинка-фон вместо подложки-градиента">
                    <Icon Name="image" />
                    @(HasBackground ? "Сменить фон" : "Фон картинкой")
                    <InputFile OnChange="OnUploadBackground"
                               accept="image/*"
                               class="visually-hidden-file" />
                </label>
                @if (HasBackground)
                {
                    <button type="button"
                            class="btn-danger"
                            @onclick="OnClearBackground"
                            title="Убрать картинку-фон">
                        <Icon Name="x" />
                        Убрать фон
                    </button>
                }
            </div>
            <RangeRow Label="Затемнение фона"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Background.DarkenAlpha"
                      ValueChanged="v => Bg(s => s with { DarkenAlpha = v })" />
            <RangeRow Label="Размытие фона, px"
                      Min="0"
                      Max="30"
                      Step="0.5f"
                      Value="@Style.Background.BlurSigma"
                      ValueChanged="v => Bg(s => s with { BlurSigma = v })" />
        </details>

        <details class="sec">
            <summary>Лого</summary>
            <p class="hint">Загрузите картинку лого/водяного знака – она рисуется в углу при включённом переключателе.</p>
            <div class="row">
                <label class="btn btn-ghost"
                       title="Лого/водяной знак картинкой в углу кадра">
                    <Icon Name="image" />
                    @(HasLogo ? "Сменить лого" : "Лого картинкой")
                    <InputFile OnChange="OnUploadLogo"
                               accept="image/*"
                               class="visually-hidden-file" />
                </label>
                @if (HasLogo)
                {
                    <button type="button"
                            class="btn-danger"
                            @onclick="OnClearLogo"
                            title="Убрать лого">
                        <Icon Name="x" />
                        Убрать лого
                    </button>
                }
            </div>
            <label class="prow"><span class="pname">Включено</span><input type="checkbox"
                                                                          checked="@Style.Logo.Enabled"
                                                                          @onchange="e => Lg(s => s with { Enabled = (bool)e.Value! })" /></label>
            <label class="prow"><span class="pname">Угол</span>
                <select @onchange="e => Lg(s => s with { Corner = (string)e.Value! })">
                    <option value="tl"
                            selected="@(Style.Logo.Corner == "tl")">Слева сверху
                    </option>
                    <option value="tr"
                            selected="@(Style.Logo.Corner == "tr")">Справа сверху
                    </option>
                    <option value="bl"
                            selected="@(Style.Logo.Corner == "bl")">Слева снизу
                    </option>
                    <option value="br"
                            selected="@(Style.Logo.Corner == "br")">Справа снизу
                    </option>
                </select>
            </label>
            <RangeRow Label="Размер, доля ширины"
                      Min="0.02f"
                      Max="0.5f"
                      Step="0.005f"
                      Value="@Style.Logo.SizeFraction"
                      ValueChanged="v => Lg(s => s with { SizeFraction = v })" />
            <RangeRow Label="Непрозрачность"
                      Min="0"
                      Max="1"
                      Step="0.01f"
                      Value="@Style.Logo.Opacity"
                      ValueChanged="v => Lg(s => s with { Opacity = v })" />
            <RangeRow Label="Отступ от края"
                      Min="0"
                      Max="0.2f"
                      Step="0.005f"
                      Value="@Style.Logo.MarginFraction"
                      ValueChanged="v => Lg(s => s with { MarginFraction = v })" />
        </details>
    </div>
</details>
